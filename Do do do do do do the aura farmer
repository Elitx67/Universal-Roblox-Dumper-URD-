-- 2. Dump Scripts Button
local BtnDumpScripts = createButton("📜 2. Decompile Scripts (.luau)", Color3.fromRGB(200, 50, 50), 385)
BtnDumpScripts.MouseButton1Click:Connect(function()
    if not writefile or not getscriptbytecode then
        StatusBar.Text = "Status: ❌ Executor lacks write/decompile support."
        StatusBar.TextColor3 = Color3.fromRGB(255, 80, 80)
        return
    end
    
    StatusBar.Text = "Status: Extracting... (Do not close)"
    StatusBar.TextColor3 = Color3.fromRGB(255, 200, 50)
    
    local function scanAndDump(container, folderName)
        local dumpFolder = MainFolder .. "/" .. folderName
        if not isfolder(dumpFolder) then makefolder(dumpFolder) end
        
        local count = 0
        for _, obj in pairs(container:GetDescendants()) do
            if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
                local success, bytecode = pcall(function()
                    return getscriptbytecode(obj)
                end)
                
                if success and bytecode and bytecode ~= "" then
                    local safeName = sanitizeFileName(obj.Name)
                    local fileName = dumpFolder .. "/" .. safeName .. "_" .. math.random(1000, 9999) .. ".luau"
                    writefile(fileName, bytecode)
                    count = count + 1
                end
            end
        end
        return count
    end

    local totalDumped = 0
    if getPlayerGui() then totalDumped = totalDumped + scanAndDump(PlayerGui, "PlayerGui") end
    if getReplicated() then totalDumped = totalDumped + scanAndDump(ReplicatedStorage, "ReplicatedStorage") end
    if getWorkspace() then totalDumped = totalDumped + scanAndDump(Workspace, "Workspace") end
    if getLighting() then totalDumped = totalDumped + scanAndDump(Lighting, "Lighting") end

    StatusBar.Text = "Status: ✅ Success! " .. totalDumped .. " scripts saved."
    StatusBar.TextColor3 = Color3.fromRGB(0, 255, 100)
end)

